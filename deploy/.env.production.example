# Настройки для сервера в интернете.
#  • Docker + PostgreSQL: скопируйте в корень проекта как .env (для docker-compose.postgres.yml)
#  • VPS без Docker: скрипт deploy/vps/install.sh создаст backend/.env сам
ENV=production
APP_NAME="Blind Barber"

# ОБЯЗАТЕЛЬНО поменяйте! С паролем admin123 сервер в режиме production не запустится.
ADMIN_EMAIL=admin@barber.kz
ADMIN_PASSWORD=придумайте-длинный-пароль

# Пароль базы PostgreSQL (для docker-compose.postgres.yml)
POSTGRES_PASSWORD=ещё-один-длинный-пароль

# Демо-данные: true — сайт сразу наполнен барбершопами и товарами; false — пустая база
SEED_DEMO_DATA=true

# Число процессов сервера: 1 для SQLite, 2–4 для PostgreSQL
WEB_CONCURRENCY=2

TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
