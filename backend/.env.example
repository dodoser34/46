# Настройки для запуска на своём компьютере. Скопируйте в backend/.env.
# Для сервера в интернете — смотрите deploy/.env.production.example.
APP_NAME="Blind Barber"
ENV=development
DEBUG=false

# Раздавать сайт вместе с API. backend/start.cmd отключает это для раздельного запуска.
SERVE_FRONTEND=true

# База данных. Пусто = SQLite в файле backend/data/barber.db
# DATABASE_URL=postgresql://user:password@localhost:5432/barber
# DATA_DIR=./data

# Создавать таблицы и демо-данные при запуске сервера
INIT_DB_ON_STARTUP=true
SEED_DEMO_DATA=true

# Администратор (создаётся вместе с демо-данными при первом запуске)
ADMIN_EMAIL=admin@barber.kz
ADMIN_PASSWORD=admin123

# Безопасность входа
TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15

# Если фронтенд на другом домене — перечислите через запятую
# CORS_ORIGINS=https://barber.example.com
